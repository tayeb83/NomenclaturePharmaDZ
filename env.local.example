# PharmaVeille DZ / DwaDZ — Exemple de configuration locale
# Copier ce fichier vers .env.local et remplir les valeurs.
# ⚠️ Ne JAMAIS committer .env.local ni env.local : ces fichiers contiennent des secrets.

# ─── POSTGRESQL ───────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSL=true

# ─── APP ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PharmaVeille DZ
# Générer avec : openssl rand -hex 32
API_SECRET_KEY=
# Générer avec : openssl rand -hex 16
CRON_SECRET=
# Mot de passe d'accès à /admin (long et aléatoire)
ADMIN_PASSWORD=
# Secret de signature des sessions admin — générer avec : openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ─── ADSENSE (optionnel) ──────────────────────────────────────
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_MEDICAMENTS=

# ─── NEWSLETTER / EMAIL ───────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PharmaVeille DZ
BREVO_LIST_ID=1
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── RÉSEAUX SOCIAUX (optionnel) ──────────────────────────────
# Utilisés pour les alertes retraits/nouveautés ET la publication
# quotidienne des pharmacies de garde (/api/cron/garde-daily) :
# token de Page longue durée avec les permissions pages_manage_posts
# + pages_read_engagement.
FACEBOOK_PAGE_ACCESS_TOKEN=
# Espacement entre deux publications de garde (ms) et budget de temps total
# de l'invocation (ms). Optionnels — valeurs par défaut : 8000 et 50000.
GARDE_POST_DELAY_MS=
GARDE_TIME_BUDGET_MS=
# Langues publiées (post distinct par langue). Optionnel — défaut "fr,ar".
# Ex. "fr" pour ne publier qu'en français, "ar" pour l'arabe seul.
GARDE_PUBLISH_LOCALES=
FACEBOOK_PAGE_ID=
# ─── Publications thématiques Facebook (rubriques nomenclature) ───
# Espacement (en jours) entre deux posts thématiques. Optionnel — défaut 3.
SOCIAL_POST_INTERVAL_DAYS=
# Nombre de brouillons d'avance maintenus en file par le cron. Optionnel — défaut 5.
SOCIAL_TARGET_PENDING=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ─── PUSH (optionnel, app mobile) ─────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=
