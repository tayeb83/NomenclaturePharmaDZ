# PharmaVeille DZ / DwaDZ — Exemple de configuration locale
# Copier ce fichier vers .env.local et remplir les valeurs.
# ⚠️ Ne JAMAIS committer .env.local ni env.local : ces fichiers contiennent des secrets.

# ─── POSTGRESQL ───────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSL=true

# ─── APP ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PharmaVeille DZ
# Générer avec : openssl rand -hex 32
API_SECRET_KEY=
# Générer avec : openssl rand -hex 16
CRON_SECRET=
# Mot de passe d'accès à /admin (long et aléatoire)
ADMIN_PASSWORD=
# Secret de signature des sessions admin — générer avec : openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ─── ADSENSE (optionnel) ──────────────────────────────────────
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_MEDICAMENTS=

# ─── NEWSLETTER / EMAIL ───────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PharmaVeille DZ
BREVO_LIST_ID=1
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── RÉSEAUX SOCIAUX (optionnel) ──────────────────────────────
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ─── PUSH (optionnel, app mobile) ─────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=
